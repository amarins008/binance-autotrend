{
  "icons": {
    "16": "./gen-assets/icon16.plasmo.png",
    "32": "./gen-assets/icon32.plasmo.png",
    "48": "./gen-assets/icon48.plasmo.png",
    "64": "./gen-assets/icon64.plasmo.png",
    "128": "./gen-assets/icon128.plasmo.png"
  },
  "manifest_version": 3,
  "action": {
    "default_icon": {
      "16": "./gen-assets/icon16.plasmo.png",
      "32": "./gen-assets/icon32.plasmo.png",
      "48": "./gen-assets/icon48.plasmo.png",
      "64": "./gen-assets/icon64.plasmo.png",
      "128": "./gen-assets/icon128.plasmo.png"
    }
  },
  "version": "0.2.0",
  "author": "KGB008",
  "name": "Binance AI Copilot",
  "description": "AI overlay, order book analytics, and one-click trade actions for Binance",
  "permissions": [
    "storage",
    "notifications"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.binance.com/*"
      ],
      "js": [
        "contents/binance-overlay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://www.binance.com/*",
    "https://fapi.binance.com/*",
    "http://127.0.0.1:8000/*",
    "http://127.0.0.1:8020/*",
    "http://127.0.0.1:8022/*"
  ]
}
