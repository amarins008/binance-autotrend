{
  "name": "binance-autotrend-cmux-hermes",
  "version": "0.1.0",
  "description": "Binance autotrend control plane built on Cmux + Hermes",
  "author": "KGB008",
  "scripts": {
    "cmux:serve": "python backend/cmux_service.py serve",
    "cmux:start": "python backend/cmux_cli.py cmux start",
    "cmux:stop": "python backend/cmux_cli.py cmux stop",
    "cmux:status": "python backend/cmux_cli.py cmux status",
    "dashboard:serve": "python backend/dashboard_server.py --host 0.0.0.0 --port 8040",
    "hermes:start": "python backend/cmux_cli.py start",
    "hermes:stop": "python backend/cmux_cli.py stop --force",
    "hermes:status": "python backend/cmux_cli.py status",
    "hermes:service:start": "python backend/cmux_cli.py service start",
    "hermes:service:stop": "python backend/cmux_cli.py service stop",
    "hermes:service:status": "python backend/cmux_cli.py service status"
  },
  "dependencies": {},
  "devDependencies": {}
}
